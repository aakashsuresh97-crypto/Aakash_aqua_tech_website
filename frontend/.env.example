# Base URL of the Category API (without a trailing slash).
# "/api" works in development: Vite proxies it to VITE_DEV_PROXY_TARGET, so no CORS is needed.
VITE_API_BASE_URL=/api

# Where your Express backend is running (used by the dev/preview proxy only)
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Max image size (MB) checked in the browser before uploading. Keep it <= the API's MAX_IMAGE_SIZE_MB.
VITE_MAX_IMAGE_MB=5

# Product UI (all optional)
# ISO currency code used to format prices (default INR)
VITE_CURRENCY=INR

# Build-time only (not read by the browser): domain and API used to write sitemap.xml
# SITE_URL=https://aakashaquatech.in
# SEO_API_URL=https://api.aakashaquatech.in/api
