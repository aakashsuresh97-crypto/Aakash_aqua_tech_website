PORT=3000

# Point these at your EXISTING MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_existing_database
DB_CONNECTION_LIMIT=10

# --- Image uploads (stored on local disk and served from /uploads) ---
# Public base URL used to build the saved image URL (no trailing slash).
# Leave empty in development: it is derived from the request (http://localhost:3000).
# In production set it, e.g. https://api.example.com
PUBLIC_BASE_URL=
# Where files are stored (default: ./uploads). Use a persistent disk/volume in production.
UPLOAD_DIR=
# Maximum image size in MB (default 5)
MAX_IMAGE_SIZE_MB=5


# --- Admin login (JWT) ---
# REQUIRED. A long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a login stays valid (e.g. 8h, 1d)
JWT_EXPIRES_IN=8h
# Failed/successful login attempts allowed per IP per 15 minutes
AUTH_LOGIN_MAX_ATTEMPTS=10
# Browser origins allowed to call the API from another domain, comma separated (no trailing slash).
# Leave empty in development (the Vite dev server proxies /api, so no CORS is needed).
# Production example: https://aakashaquatech.in
CORS_ORIGINS=
# Set to 1 when the API sits behind nginx / a hosting proxy so rate limits see the real client IP
TRUST_PROXY=0


# =====================================================================
# Storefront, customers, orders, payments (migrations 009+)
# =====================================================================
# --- Company details printed on invoices ---
COMPANY_NAME=Aakash Pure Aqua Tech Pvt Ltd
COMPANY_ADDRESS=10/62C, Brindavan Road, 1st Cross (Behind Dr. Sudamani Hospital), Fairlands, Salem, Tamil Nadu 636016
COMPANY_GSTIN=
# Selling from this state => CGST + SGST on the invoice; any other state => IGST
COMPANY_STATE=Tamil Nadu
COMPANY_PHONE=96555 77666
COMPANY_EMAIL=ceo@aakashaquatech.in

# --- Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys). Use rzp_test_ keys until you go live ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> add https://<your-api>/api/webhooks/razorpay, events: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=
# Cash on Delivery: 0 switches it off; COD_MAX_AMOUNT (rupees) caps the order value (0 = no cap)
COD_ENABLED=1
COD_MAX_AMOUNT=0
# Minutes an online order may stay unpaid before it is cancelled and its stock released
ORDER_PAYMENT_WINDOW_MIN=30

# --- Customer login (email + password) ---
CUSTOMER_JWT_EXPIRES_IN=30d
# 5 wrong passwords lock that account for 15 minutes
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Per IP: failed logins per 15 minutes, sign-ups per hour
CUSTOMER_LOGIN_RATE_MAX=10
CUSTOMER_REGISTER_RATE_MAX=10

# --- Spam protection for the public forms (demo popup, contact, service request): submissions per IP per 15 minutes ---
FORM_RATE_MAX=10

# --- "New lead / order / service request" notifications (all optional; any combination) ---
# Webhook receives POST JSON { event, title, text, data } (works with Slack/Discord/Zapier/Make style endpoints)
NOTIFY_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL_TO=
# Set 0 to stop printing notifications in the server log
NOTIFY_CONSOLE=1
