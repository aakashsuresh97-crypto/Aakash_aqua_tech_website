{
  "info": {
    "name": "Category CRUD API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "imageCategoryId",
      "value": ""
    },
    {
      "key": "imageUrl",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create category",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\",()=>pm.response.to.have.status(201));",
              "const id = pm.response.json().data.id;",
              "pm.test(\"id is a UUID string\",()=>pm.expect(id).to.be.a(\"string\").and.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/));",
              "pm.collectionVariables.set(\"categoryId\", id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category_name\": \"Water Purifiers\",\n  \"description\": \"RO and UV purifiers\",\n  \"image\": \"https://example.com/purifier.png\",\n  \"status\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        }
      }
    },
    {
      "name": "2. Get all categories",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories?page=1&limit=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "3. Get all (active, search)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories?status=active&search=water",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ],
          "query": [
            {
              "key": "status",
              "value": "active"
            },
            {
              "key": "search",
              "value": "water"
            }
          ]
        }
      }
    },
    {
      "name": "4. Get category by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories",
            "{{categoryId}}"
          ]
        }
      }
    },
    {
      "name": "5. Update category",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category_name\": \"RO Purifiers\",\n  \"description\": \"Updated description\",\n  \"status\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories",
            "{{categoryId}}"
          ]
        }
      }
    },
    {
      "name": "6. Delete category",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories",
            "{{categoryId}}"
          ]
        }
      }
    },
    {
      "name": "7. Get deleted category (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 404\",()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories/{{categoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories",
            "{{categoryId}}"
          ]
        }
      }
    },
    {
      "name": "8. Create without name (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"no name\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        }
      }
    },
    {
      "name": "9. Invalid id (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 400\",()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories/abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories",
            "abc"
          ]
        }
      }
    },
    {
      "name": "8. Create category WITH image (multipart)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\",()=>pm.response.to.have.status(201));",
              "const d = pm.response.json().data;",
              "pm.test(\"image URL generated\",()=>pm.expect(d.image).to.include('/uploads/categories/'));",
              "pm.collectionVariables.set(\"imageCategoryId\", d.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "category_name",
              "value": "Postman Image Test",
              "type": "text"
            },
            {
              "key": "description",
              "value": "uploaded from Postman",
              "type": "text"
            },
            {
              "key": "status",
              "value": "1",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        }
      }
    },
    {
      "name": "9. Change image (multipart PUT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/categories/{{imageCategoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories",
            "{{imageCategoryId}}"
          ]
        }
      }
    },
    {
      "name": "10. Remove image (multipart)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"image is null\",()=>pm.expect(pm.response.json().data.image).to.eql(null));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "remove_image",
              "value": "true",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/categories/{{imageCategoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories",
            "{{imageCategoryId}}"
          ]
        }
      }
    },
    {
      "name": "10. Lookup by metaProdCateEnty",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"returns the category\",()=>pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get(\"categoryId\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"metaProdCateEnty\": \"{{categoryId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/categories/lookup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories",
            "lookup"
          ]
        }
      }
    },
    {
      "name": "11. Upload image (multipart - file only)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\",()=>pm.response.to.have.status(201));",
              "const url = pm.response.json().data.url;",
              "pm.test(\"response has an image URL string\",()=>pm.expect(url).to.be.a(\"string\").and.match(/\\/uploads\\/categories\\/.+\\.(png|jpg|webp|gif)$/));",
              "pm.collectionVariables.set(\"imageUrl\", url);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": []
            }
          ]
        },
        "description": "Select a JPG/PNG/WEBP/GIF file in the `image` field. Only the file is sent as multipart; the response contains the URL.",
        "url": {
          "raw": "{{baseUrl}}/api/uploads/images",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "uploads",
            "images"
          ]
        }
      }
    },
    {
      "name": "12. Create category with the uploaded image URL (JSON)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\",()=>pm.response.to.have.status(201));",
              "pm.test(\"image URL is stored and returned as a string\",()=>pm.expect(pm.response.json().data.image).to.eql(pm.collectionVariables.get(\"imageUrl\")));",
              "pm.collectionVariables.set(\"imageCategoryId\", pm.response.json().data.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category_name\": \"Category with uploaded image\",\n  \"description\": \"image uploaded in a separate request\",\n  \"status\": 1,\n  \"image\": \"{{imageUrl}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        }
      }
    }
  ]
}