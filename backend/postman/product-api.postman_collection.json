          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"out of stock\", () => pm.expect(pm.response.json().message).to.eql(\"Product is out of stock\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "13. Buy Now (proceed to checkout, purchase NOT completed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}/buy-now",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
