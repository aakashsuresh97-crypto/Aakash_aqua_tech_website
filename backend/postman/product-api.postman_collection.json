                "v1",
                "products",
                "{{productId}}",
                "buy-now"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"checkout summary, nothing purchased\", () => { pm.expect(d.purchase_completed).to.eql(false); pm.expect(d.next_step).to.eql(\"CHECKOUT\"); pm.expect(d.price_summary.total_payable).to.eql(18999.5); });"
                ]
