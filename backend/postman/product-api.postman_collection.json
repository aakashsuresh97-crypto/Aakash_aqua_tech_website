{
  "info": {
    "name": "Product API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders in order (Collection Runner). Setup creates a category + subcategory with the existing APIs; the product requests then use them."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "runTag",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "subcategoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "outOfStockProductId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup (existing Category + Subcategory APIs)",
      "item": [
        {
          "name": "S1. Create category (existing API)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_name\": \"Water Purifiers {{runTag}}\",\n  \"description\": \"RO and UV purifiers\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runTag\", \"pm\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"categoryId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "S2. Create subcategory (existing API)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/subcategories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "subcategories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{categoryId}}\",\n  \"subcategory_name\": \"RO Purifiers {{runTag}}\",\n  \"brand_names\": [\n    \"Kent\",\n    \"Aquaguard\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"subcategoryId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Product API",
      "item": [
        {
          "name": "1. Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{categoryId}}\",\n  \"subcategory_id\": \"{{subcategoryId}}\",\n  \"product_name\": \"Kent Grand Plus 8L RO {{runTag}}\",\n  \"brand\": \"{{runTag}}-Kent\",\n  \"mrp\": 22000,\n  \"selling_price\": 18999.5,\n  \"gst_percent\": 18,\n  \"description\": \"8 litre RO + UV + UF water purifier with TDS controller\",\n  \"image_url\": \"https://example.com/images/kent-grand-plus.png\",\n  \"stock_quantity\": 25,\n  \"specifications\": {\n    \"Capacity\": \"8 L\",\n    \"Technology\": \"RO + UV + UF\",\n    \"Warranty\": \"1 year\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"id is a UUID string\", () => pm.expect(d.id).to.be.a(\"string\").and.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/));",
                  "pm.test(\"category and subcategory names are returned\", () => pm.expect(d.category_name).to.include(\"Water Purifiers\"));",
                  "pm.test(\"discount is calculated\", () => { pm.expect(d.discount_amount).to.eql(3000.5); pm.expect(d.discount_percent).to.eql(13.64); });",
                  "pm.collectionVariables.set(\"productId\", d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Create product (out of stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{categoryId}}\",\n  \"subcategory_id\": \"{{subcategoryId}}\",\n  \"product_name\": \"Aquaguard Aura {{runTag}}\",\n  \"brand\": \"{{runTag}}-Aquaguard\",\n  \"mrp\": 15000,\n  \"selling_price\": 12500,\n  \"gst_percent\": 18,\n  \"image_url\": \"https://example.com/images/aquaguard-aura.png\",\n  \"stock_quantity\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"outOfStockProductId\", pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"same product with actions\", () => { pm.expect(d.id).to.eql(pm.collectionVariables.get(\"productId\")); pm.expect(d.actions.add_to_cart.enabled).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Get Page (example: page=1&limit=20)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/page?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "page"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"has data + meta\", () => { pm.expect(b.success).to.eql(true); pm.expect(b.data).to.be.an(\"array\"); pm.expect(b.meta).to.have.all.keys(\"total\",\"page\",\"limit\",\"totalPages\"); });",
                  "pm.test(\"every product has all required details and both actions\", () => b.data.forEach(p => {",
                  "  [\"id\",\"category_id\",\"category_name\",\"subcategory_id\",\"subcategory_name\",\"product_name\",\"brand\",\"mrp\",\"selling_price\",\"discount_amount\",\"discount_percent\",\"gst_percent\",\"description\",\"image_url\",\"stock_quantity\",\"specifications\",\"status\"].forEach(k => pm.expect(p).to.have.property(k));",
                  "  pm.expect(p.actions).to.have.property(\"add_to_cart\"); pm.expect(p.actions).to.have.property(\"buy_now\");",
                  "}));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Get Page - search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/page?search=Grand Plus 8L RO {{runTag}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "page"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Grand Plus 8L RO {{runTag}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"finds the product\", () => pm.expect(pm.response.json().data.map(p => p.id)).to.include(pm.collectionVariables.get(\"productId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Get Page - filter by category, subcategory, brand and price",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/page?category_id={{categoryId}}&subcategory_id={{subcategoryId}}&brand={{runTag}}-Kent&min_price=10000&max_price=20000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "page"
              ],
              "query": [
                {
                  "key": "category_id",
                  "value": "{{categoryId}}"
                },
                {
                  "key": "subcategory_id",
                  "value": "{{subcategoryId}}"
                },
                {
                  "key": "brand",
                  "value": "{{runTag}}-Kent"
                },
                {
                  "key": "min_price",
                  "value": "10000"
                },
                {
                  "key": "max_price",
                  "value": "20000"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exactly the matching product\", () => { const d = pm.response.json().data; pm.expect(d.length).to.eql(1); pm.expect(d[0].id).to.eql(pm.collectionVariables.get(\"productId\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Get Page - sort by price (high to low)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/page?category_id={{categoryId}}&sort_by=selling_price&sort_order=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "page"
              ],
              "query": [
                {
                  "key": "category_id",
                  "value": "{{categoryId}}"
                },
                {
                  "key": "sort_by",
                  "value": "selling_price"
                },
                {
                  "key": "sort_order",
                  "value": "desc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"sorted by selling_price desc\", () => { const p = pm.response.json().data.map(x => x.selling_price); pm.expect(p).to.eql([...p].sort((a, b) => b - a)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Get Page - out of stock product has disabled buttons",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/page?search=Aquaguard Aura {{runTag}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "page"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Aquaguard Aura {{runTag}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"buttons disabled\", () => { const a = pm.response.json().data[0].actions; pm.expect(a.add_to_cart.enabled).to.eql(false); pm.expect(a.add_to_cart.disabled_reason).to.eql(\"OUT_OF_STOCK\"); pm.expect(a.buy_now.enabled).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Add to Cart (quantity 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}/add-to-cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}",
                "add-to-cart"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const i = pm.response.json().data.item;",
                  "pm.test(\"line total\", () => { pm.expect(i.quantity).to.eql(2); pm.expect(i.line_total).to.eql(37999); });"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Add to Cart - quantity above stock (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}/add-to-cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}",
                "add-to-cart"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 26\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"insufficient stock\", () => pm.expect(pm.response.json().message).to.eql(\"Insufficient stock\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "11. Add to Cart - invalid quantity (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}/add-to-cart",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
